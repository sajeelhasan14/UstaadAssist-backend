PORT=4000
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --------------------------------------------------------------------------
# DATABASE_URL and the pooler port
#
# Supabase gives two pooler ports, and which one you want depends on how the
# server runs:
#
#   5432  session mode      - a long-running server (npm run dev, Render, Railway)
#   6543  transaction mode  - serverless functions (Vercel)
#
# Session mode holds a connection for the client's whole lifetime. On serverless
# that exhausts the connection limit, because every function instance keeps one.
# Only the port differs; host and credentials are the same.
#
# See DEPLOYMENT.md.
# --------------------------------------------------------------------------

